# Dependency directories (Equivalent to Python's venv)
node_modules/

# Build output (The compiled JavaScript)
dist/

# Architecture manifest is now committed to git so the backend Docker
# build can serve it without needing frontend_app/. Regenerate with:
#   cd backend_api && npx tsx scripts/generateArchitectureManifest.ts

# Environment variables (Crucial Security: Never commit passwords/secrets!)
.env
.env.local
.env.*.local

# Debug logs
npm-debug.log*
yarn-debug.log*

# OS specific files
.DS_Store
Thumbs.db