}\r\n.ring-offset-background {\n  --tw-ring-offset-color: hsl(var(--background));\n}\r\n.blur {\n  --tw-blur: blur(8px);\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.drop-shadow {\n  --tw-drop-shadow: drop-shadow(0 1px 2px rgb(0 0 0 / 0.1)) drop-shadow(0 1px 1px rgb(0 0 0 / 0.06));\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.invert {\n  --tw-invert: invert(100%);\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.filter {\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.backdrop-filter {\n  backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n}\r\n.transition {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-all {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-colors {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-opacity {\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-transform {\n  transition-property: transform;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.duration-300 {\n  transition-duration: 300ms;\n}\r\n.ease-in {\n  transition-timing-function: cubic-bezier(0.4, 0, 1, 1);\n}\r\n.ease-in-out {\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\r\n.ease-out {\n  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\r\n\r\n/* ─── Premium micro-interactions ──────────────────────────────────────────── */\r\n\r\n.j2-press {\r\n  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n}\r\n.j2-press:active {\r\n  transform: scale(0.97);\r\n  transition: transform 0.08s ease-out;\r\n}\r\n\r\n/* ─── Heatmap cell hover glow ─────────────────────────────────────────────── */\r\n\r\n.j2-heatmap-cell:hover {\r\n  box-shadow: inset 0 0 0 1px rgba(242,228,168,0.3), 0 0 6px rgba(242,228,168,0.1);\r\n  transition: box-shadow 0.2s ease;\r\n}\r\n\r\n/* ─── Streak cell sheen sweep ─────────────────────────────────────────────── */\r\n/*\r\n * Each streak cell gets the same sheen animation but with a delay proportional\r\n * to its chronological position (--streak-delay, set inline). This makes the\r\n * glint appear to sweep left→right across all consecutive streak cells.\r\n *\r\n * Period: 5s. Sheen crosses in the first 20% (~1s), then holds off-screen\r\n * for the remaining 80% — so the effect reads as a flash, not a crawl.\r\n */\r\n\r\n@keyframes j2-streak-sheen {\r\n  0%   { transform: skewX(-18deg) translateX(-200%); opacity: 0;   }\r\n  5%   { opacity: 1; }\r\n  20%  { transform: skewX(-18deg) translateX(350%);  opacity: 0;   }\r\n  100% { transform: skewX(-18deg) translateX(350%);  opacity: 0;   }\r\n}\r\n\r\n.j2-streak-cell {\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Dark overlay: uniformly darkens the cell background so the champagne\r\n   sheen has consistent contrast regardless of intensity color */\r\n.j2-streak-cell::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.22);\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.j2-streak-cell::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: -30%;\r\n  left: 0;\r\n  width: 45%;\r\n  height: 160%;\r\n  background: linear-gradient(\r\n    to right,\r\n    transparent,\r\n    rgba(242, 228, 168, 0.35) 50%,\r\n    transparent\r\n  );\r\n  animation: j2-streak-sheen 5s ease-in-out infinite;\r\n  pointer-events: none;\r\n  z-index: 1;\r\n}\r\n\r\n/* ─── Reduced motion ─────────────────────────────────────────────────────── */\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  /* Disable streak sheen sweep */\r\n  .j2-streak-cell::after {\r\n    animation: none !important;\r\n  }\r\n  /* Disable heatmap hover transitions */\r\n  .j2-heatmap-cell {\r\n    transition: none !important;\r\n  }\r\n}\r\n\r\n/* ─── Glassmorphism modal backdrop ────────────────────────────────────────── */\r\n\r\n.j2-glass {\r\n  backdrop-filter: blur(12px) saturate(1.2);\r\n  background: rgba(21, 46, 34, 0.85);\r\n}\r\n\r\n/* ─── Desktop editorial utilities (Phase 1) ───────────────────────────────\r\n   Opt-in classes used only by desktop (≥1024px) layouts. Nothing in this\r\n   block is applied globally — mobile rendering is unchanged until a\r\n   component explicitly adopts one of these classes. */\r\n\r\n.j2-wordmark {\r\n  font-family: var(--font-wordmark);\r\n  font-weight: 600;\r\n  color: var(--champagne);\r\n  text-shadow: var(--glow-title);\r\n  letter-spacing: -0.01em;\r\n  line-height: 1;\r\n}\r\n\r\n.j2-serif-display {\r\n  font-family: var(--font-editorial);\r\n  font-weight: 600;\r\n  letter-spacing: -0.015em;\r\n  color: var(--champagne);\r\n}\r\n\r\n.j2-serif-italic {\r\n  font-family: var(--font-editorial);\r\n  font-style: italic;\r\n  font-weight: 500;\r\n  color: rgba(255,255,255,0.60);\r\n}\r\n\r\n.j2-heading-glow {\r\n  color: var(--champagne);\r\n  text-shadow: var(--glow-soft);\r\n}\r\n\r\n.j2-label-micro {\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.18em;\r\n  text-transform: uppercase;\r\n  color: rgba(255,255,255,0.40);\r\n}\r\n\r\n.j2-label-copper {\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.18em;\r\n  text-transform: uppercase;\r\n  color: var(--copper);\r\n}\r\n\r\n/* Desktop: bump defaults so inherited text doesn't feel tiny.\r\n   Most explicit px sizes are also scaled up in components. */\r\n@media (min-width: 1024px) {\r\n  body { font-size: 16px; }\r\n  .j2-label-micro, .j2-label-copper { font-size: 13px; letter-spacing: 0.16em; }\r\n}\r\n\r\n/* Seigaiha (wave) ambient backdrop. Fixed, pointer-events:none, below\r\n   content. Drifts slowly. Intended as a <div class=\"j2-seigaiha-bg\" />\r\n   sibling of page content on desktop. */\r\n.j2-seigaiha-bg {\r\n  position: fixed;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='40' viewBox='0 0 80 40'><g fill='none' stroke='%23C4915F' stroke-width='1' opacity='0.22'><circle cx='0' cy='40' r='36'/><circle cx='0' cy='40' r='26'/><circle cx='0' cy='40' r='16'/><circle cx='0' cy='40' r='6'/><circle cx='40' cy='40' r='36'/><circle cx='40' cy='40' r='26'/><circle cx='40' cy='40' r='16'/><circle cx='40' cy='40' r='6'/><circle cx='80' cy='40' r='36'/><circle cx='80' cy='40' r='26'/><circle cx='80' cy='40' r='16'/><circle cx='80' cy='40' r='6'/><circle cx='20' cy='20' r='36'/><circle cx='20' cy='20' r='26'/><circle cx='20' cy='20' r='16'/><circle cx='20' cy='20' r='6'/><circle cx='60' cy='20' r='36'/><circle cx='60' cy='20' r='26'/><circle cx='60' cy='20' r='16'/><circle cx='60' cy='20' r='6'/></g></svg>\");\r\n  background-size: 80px 40px;\r\n  opacity: 0.28;\r\n  mask-image: radial-gradient(ellipse at top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);\r\n  -webkit-mask-image: radial-gradient(ellipse at top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);\r\n  animation: j2-seigaiha-drift 18s linear infinite;\r\n}\r\n\r\n@keyframes j2-seigaiha-drift {\r\n  0%   { background-position: 0 0; }\r\n  100% { background-position: 80px 40px; }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .j2-seigaiha-bg { animation: none !important; }\r\n}\r\n\r\n/* Prestige breathe — slow ethereal aura behind the consistency stat\r\n   when a practitioner reaches the 26-week 8th Gate. Breathes at ~14 BPM\r\n   to feel alive without being distracting. */\r\n@keyframes j2PrestigeBreathe {\r\n  0%, 100% { opacity: 0.35; transform: scale(0.96); }\r\n  50%      { opacity: 0.72; transform: scale(1.04); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  [style*=\"j2PrestigeBreathe\"] { animation: none !important; opacity: 0.5 !important; }\r\n}\r\n\r\n/* Vertex toggle pump — fires once when a Prism pillar is muted/unmuted.\r\n   Mirrors iOS toggle-switch overshoot via spring curve. */\r\n@keyframes j2VertexToggle {\r\n  0%   { transform: scale(1); }\r\n  35%  { transform: scale(1.35); }\r\n  70%  { transform: scale(0.92); }\r\n  100% { transform: scale(1); }\r\n}\r\n\r\n/* Vertex snap-in — inner ring lock-on with a settle when the center dot\r\n   crosses the snap threshold onto a vertex. Lands ~5% past target then settles. */\r\n@keyframes j2VertexSnapIn {\r\n  0%   { transform: scale(1.4); opacity: 0; }\r\n  60%  { transform: scale(0.92); opacity: 1; }\r\n  100% { transform: scale(1);    opacity: 0.85; }\r\n}\r\n\r\n/* Vertex dot pump — fires once when a vertex becomes the snapped primary,\r\n   acknowledging the magnetic lock-on at the dot itself. */\r\n@keyframes j2VertexDotPump {\r\n  0%   { transform: scale(1); }\r\n  45%  { transform: scale(1.4); }\r\n  100% { transform: scale(1); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  [style*=\"j2VertexToggle\"],\r\n  [style*=\"j2VertexSnapIn\"],\r\n  [style*=\"j2VertexDotPump\"] { animation: none !important; }\r\n}\r\n\r\n/* Journal inscribe — line-by-line fade-up reveal of a saved journal entry.\r\n   Each line gets a staggered animation-delay so prose appears as if being\r\n   written onto the mat. Lines respect actual word-wrap break points\r\n   (computed via Pretext) so the cadence reads as sentences, not characters. */\r\n@keyframes j2InscribeLine {\r\n  0%   { opacity: 0; transform: translateY(4px); }\r\n  100% { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  [style*=\"j2InscribeLine\"] { animation: none !important; opacity: 1 !important; transform: none !important; }\r\n}\r\n\r\n.placeholder\\:text-white\\/30::-moz-placeholder {\n  color: rgb(255 255 255 / 0.3);\n}\r\n\r\n.placeholder\\:text-white\\/30::placeholder {\n  color: rgb(255 255 255 / 0.3);\n}\r\n\r\n.hover\\:bg-brand-orange\\/90:hover {\n  background-color: rgb(218 116 34 / 0.9);\n}\r\n\r\n.hover\\:bg-secondary:hover {\n  background-color: hsl(var(--secondary));\n}\r\n\r\n.hover\\:bg-white\\/20:hover {\n  background-color: rgb(255 255 255 / 0.2);\n}\r\n\r\n.hover\\:bg-white\\/5:hover {\n  background-color: rgb(255 255 255 / 0.05);\n}\r\n\r\n.hover\\:text-\\[\\#F2E4A8\\]:hover {\n  --tw-text-opacity: 1;\n  color: rgb(242 228 168 / var(--tw-text-opacity, 1));\n}\r\n\r\n.hover\\:text-white:hover {\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n}\r\n\r\n.hover\\:text-white\\/70:hover {\n  color: rgb(255 255 255 / 0.7);\n}\r\n\r\n.hover\\:opacity-70:hover {\n  opacity: 0.7;\n}\r\n\r\n.focus\\:bg-accent:focus {\n  background-color: hsl(var(--accent));\n}\r\n\r\n.focus\\:text-accent-foreground:focus {\n  color: hsl(var(--accent-foreground));\n}\r\n\r\n.focus\\:opacity-100:focus {\n  opacity: 1;\n}\r\n\r\n.focus\\:outline-none:focus {\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\r\n\r\n.focus\\:ring-1:focus {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(1px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n}\r\n\r\n.focus\\:ring-2:focus {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n}\r\n\r\n.focus\\:ring-brand-orange:focus {\n  --tw-ring-opacity: 1;\n  --tw-ring-color: rgb(218 116 34 / var(--tw-ring-opacity, 1));\n}\r\n\r\n.focus\\:ring-ring:focus {\n  --tw-ring-color: hsl(var(--ring));\n}\r\n\r\n.focus\\:ring-offset-2:focus {\n  --tw-ring-offset-width: 2px;\n}\r\n\r\n.disabled\\:pointer-events-none:disabled {\n  pointer-events: none;\n}\r\n\r\n.disabled\\:cursor-not-allowed:disabled {\n  cursor: not-allowed;\n}\r\n\r\n.disabled\\:opacity-20:disabled {\n  opacity: 0.2;\n}\r\n\r\n.disabled\\:opacity-40:disabled {\n  opacity: 0.4;\n}\r\n\r\n.disabled\\:opacity-50:disabled {\n  opacity: 0.5;\n}\r\n\r\n.group:hover .group-hover\\:opacity-100 {\n  opacity: 1;\n}\r\n\r\n.group.destructive .group-\\[\\.destructive\\]\\:border-muted\\/40 {\n  border-color: hsl(var(--muted) / 0.4);\n}\r\n\r\n.group.destructive .group-\\[\\.destructive\\]\\:hover\\:border-destructive\\/30:hover {\n  border-color: hsl(var(--destructive) / 0.3);\n}\r\n\r\n.group.destructive .group-\\[\\.destructive\\]\\:hover\\:bg-destructive:hover {\n  background-color: hsl(var(--destructive));\n}\r\n\r\n.group.destructive .group-\\[\\.destructive\\]\\:hover\\:text-destructive-foreground:hover {\n  color: hsl(var(--destructive-foreground));\n}\r\n\r\n.group.destructive .group-\\[\\.de